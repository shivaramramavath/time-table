<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='x-apple-disable-message-reformatting' />
    <title>Reset Your Password - Time Table</title>
  </head>

  <body
    style='margin:0;padding:0;background-color:#f5f5f5;font-family:Arial,Helvetica,sans-serif;color:#171717;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color:#f5f5f5;'
    >
      <tr>
        <td align='center' style='padding:40px 16px;'>

          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width:580px;background-color:#ffffff;border:1px solid #e5e5e5;border-radius:14px;overflow:hidden;'
          >

            <!-- Brand header -->
            <tr>
              <td style='padding:26px 32px;border-bottom:1px solid #eeeeee;'>
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                >
                  <tr>
                    <td valign='middle'>
                      <table
                        role='presentation'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                      >
                        <tr>
                          <td
                            width='38'
                            height='38'
                            align='center'
                            valign='middle'
                            style='width:38px;height:38px;background-color:#171717;border-radius:10px;color:#ffffff;font-size:19px;font-weight:700;'
                          >
                            T
                          </td>
                          <td valign='middle' style='padding-left:11px;'>
                            <p
                              style='margin:0;color:#171717;font-size:18px;font-weight:700;letter-spacing:-0.5px;'
                            >
                              Time Table
                            </p>
                            <p
                              style='margin:3px 0 0;color:#737373;font-size:11px;'
                            >
                              ACCOUNT SECURITY
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td align='right' valign='middle'>
                      <span
                        style='display:inline-block;padding:7px 10px;background-color:#fafafa;border:1px solid #e5e5e5;border-radius:20px;color:#525252;font-size:11px;font-weight:700;'
                      >
                        SECURITY NOTICE
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main content -->
            <tr>
              <td style='padding:40px 32px 36px;'>

                <!-- Lock icon -->
                <table
                  role='presentation'
                  align='center'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                >
                  <tr>
                    <td
                      width='62'
                      height='62'
                      align='center'
                      valign='middle'
                      style='width:62px;height:62px;background-color:#f5f5f5;border:1px solid #e5e5e5;border-radius:16px;color:#171717;font-size:27px;line-height:62px;'
                    >
                      &#128274;
                    </td>
                  </tr>
                </table>

                <p
                  style='margin:28px 0 12px;color:#737373;font-size:11px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;text-align:center;'
                >
                  Password assistance
                </p>

                <h1
                  style='margin:0;color:#171717;font-size:32px;line-height:1.25;font-weight:700;letter-spacing:-1px;text-align:center;'
                >
                  Let's get you back in.
                </h1>

                <p
                  style='margin:18px 0 0;color:#525252;font-size:15px;line-height:1.9;text-align:center;'
                >
                  Hi
                  {{userName}}, we received a request to reset the password for
                  your Time Table account.
                </p>

                <p
                  style='margin:10px 0 0;color:#737373;font-size:14px;line-height:1.9;text-align:center;'
                >
                  Use the secure link below to choose a new password and regain
                  access to your account.
                </p>

                <!-- Reset button -->
                <table
                  role='presentation'
                  align='center'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin:30px auto 0;'
                >
                  <tr>
                    <td
                      align='center'
                      bgcolor='#171717'
                      style='background-color:#171717;border-radius:8px;'
                    >
                      <a
                        href='{{resetUrl}}'
                        target='_blank'
                        style='display:inline-block;padding:16px 32px;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;text-decoration:none;border-radius:8px;'
                      >
                        Reset my password &nbsp; &#8594;
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style='margin:14px 0 0;color:#a3a3a3;font-size:11px;line-height:1.7;text-align:center;'
                >
                  If you didn't request this change, no action is needed.
                </p>

                <!-- Security information -->
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-top:34px;background-color:#fafafa;border:1px solid #e5e5e5;border-radius:10px;'
                >
                  <tr>
                    <td
                      width='42'
                      valign='top'
                      style='padding:18px 0 18px 18px;'
                    >
                      <p
                        style='margin:0;color:#525252;font-size:17px;line-height:1.5;'
                      >
                        &#9432;
                      </p>
                    </td>
                    <td valign='top' style='padding:18px 18px 18px 10px;'>
                      <p
                        style='margin:0;color:#171717;font-size:13px;font-weight:700;line-height:1.6;'
                      >
                        Keep your account secure
                      </p>
                      <p
                        style='margin:6px 0 0;color:#525252;font-size:12px;line-height:1.9;'
                      >
                        Your password will not change unless you complete the
                        reset process. Never share your reset link with anyone.
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Link fallback -->
                <p
                  style='margin:30px 0 8px;color:#525252;font-size:12px;line-height:1.8;'
                >
                  <strong>Button not working?</strong>
                  Copy and paste this link into your browser:
                </p>

                <p
                  style='margin:0;padding:13px 14px;background-color:#fafafa;border:1px solid #eeeeee;border-radius:8px;font-size:12px;line-height:1.8;word-break:break-all;overflow-wrap:anywhere;'
                >
                  <a
                    href='{{resetUrl}}'
                    target='_blank'
                    style='color:#404040;text-decoration:underline;'
                  >
                    {{resetUrl}}
                  </a>
                </p>

                <p
                  style='margin:22px 0 0;color:#737373;font-size:12px;line-height:1.8;text-align:center;'
                >
                  If you didn't request a password reset, you can safely ignore
                  this email. Your existing password will remain unchanged.
                </p>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='padding:24px 32px;background-color:#fafafa;border-top:1px solid #eeeeee;'
              >

                <p
                  style='margin:0;color:#171717;font-size:13px;font-weight:700;'
                >
                  Time Table
                </p>

                <p
                  style='margin:8px 0 0;color:#737373;font-size:11px;line-height:1.8;'
                >
                  Plan smarter. Achieve more.
                </p>

                <p
                  style='margin:18px 0 0;color:#a3a3a3;font-size:11px;line-height:1.8;'
                >
                  &copy; 2026 Time Table. All rights reserved.<br />
                  This is an automated security email. Please do not reply.
                </p>

              </td>
            </tr>

          </table>

          <p
            style='max-width:400px;margin:20px auto 0;color:#a3a3a3;font-size:11px;line-height:1.7;text-align:center;'
          >
            This email was sent because a password reset was requested for your
            account.
          </p>

        </td>
      </tr>
    </table>
  </body>
</html>