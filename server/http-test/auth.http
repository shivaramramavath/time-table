
@baseUrl = http://localhost:8080/api/auth
@email = ramavathshiva6300@gmail.com
@password = 12345678

### 1. Sign up
POST {{baseUrl}}/signup
Content-Type: application/json
Accept: application/json

{
  "userName": "test-1",
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 2. Sign in
POST {{baseUrl}}/signin
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 3. Refresh access token
# Sends the refreshToken cookie received from sign-in.
POST {{baseUrl}}/refresh
Accept: application/json

###

### 4. Sign out
# Requires a valid refreshToken cookie.
POST {{baseUrl}}/signout
Accept: application/json

###

### 5. Forgot password
POST {{baseUrl}}/forgot-password
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}"
}

###

