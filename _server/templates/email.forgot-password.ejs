<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="x-apple-disable-message-reformatting" />

    <title>Reset Your Password</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f4f5;
      font-family: Arial, Helvetica, sans-serif;
      color: #111827;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      role="presentation"
      style="width: 100%; margin: 0; padding: 0; background-color: #f4f4f5"
    >
      <tr>
        <td align="center" style="padding: 40px 16px">
          <!-- Main Container -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
            style="
              width: 100%;
              max-width: 560px;
              background-color: #ffffff;
              border: 1px solid #e5e7eb;
              border-radius: 20px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 34px 24px; background-color: #111111"
              >
                <h1
                  style="
                    margin: 0;
                    padding: 0;
                    color: #ffffff;
                    font-size: 28px;
                    line-height: 1.2;
                    font-weight: 700;
                  "
                >
                  Time Table
                </h1>

                <p
                  style="
                    margin: 10px 0 0;
                    padding: 0;
                    color: #a1a1aa;
                    font-size: 14px;
                    line-height: 1.5;
                  "
                >
                  Secure account management
                </p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 42px 32px">
                <!-- Heading -->
                <h2
                  style="
                    margin: 0;
                    padding: 0;
                    color: #111827;
                    font-size: 26px;
                    line-height: 1.3;
                    font-weight: 700;
                    text-align: center;
                  "
                >
                  Reset Your Password
                </h2>

                <!-- Description -->
                <p
                  style="
                    margin: 16px 0 0;
                    padding: 0;
                    color: #6b7280;
                    font-size: 15px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  We received a request to reset the password for your Time
                  Table account.
                </p>

                <p
                  style="
                    margin: 10px 0 0;
                    padding: 0;
                    color: #6b7280;
                    font-size: 15px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  Click the button below to create a new password.
                </p>

                <!-- Reset Button -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                  style="margin: 34px 0"
                >
                  <tr>
                    <td align="center">
                      <a
                        href="<%= resetUrl %>"
                        target="_blank"
                        style="
                          display: inline-block;
                          padding: 15px 30px;
                          background-color: #111111;
                          color: #ffffff;
                          font-size: 15px;
                          line-height: 1;
                          font-weight: 600;
                          text-decoration: none;
                          border-radius: 10px;
                        "
                      >
                        Reset Password
                      </a>
                    </td>
                  </tr>
                </table>

                <!-- Expiration Information -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                  style="
                    background-color: #fafafa;
                    border: 1px solid #e5e7eb;
                    border-radius: 14px;
                  "
                >
                  <tr>
                    <td style="padding: 18px">
                      <p
                        style="
                          margin: 0;
                          padding: 0;
                          color: #52525b;
                          font-size: 14px;
                          line-height: 1.8;
                          text-align: center;
                        "
                      >
                        This password reset link is valid for
                        <strong>15 minutes</strong>.
                        <br />
                        For your security, never share this link with anyone.
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Fallback Link -->
                <p
                  style="
                    margin: 28px 0 0;
                    padding: 0;
                    color: #9ca3af;
                    font-size: 12px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  If the button doesn't work, copy and paste the following link
                  into your browser:
                </p>

                <p
                  style="
                    margin: 8px 0 0;
                    padding: 0;
                    color: #6b7280;
                    font-size: 12px;
                    line-height: 1.6;
                    text-align: center;
                    word-break: break-all;
                  "
                >
                  <a
                    href="<%= resetUrl %>"
                    target="_blank"
                    style="color: #6b7280; text-decoration: underline"
                  >
                    <%= resetUrl %>
                  </a>
                </p>

                <!-- Security Notice -->
                <p
                  style="
                    margin: 28px 0 0;
                    padding: 0;
                    color: #9ca3af;
                    font-size: 12px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  If you didn't request a password reset, you can safely ignore
                  this email. Your account remains secure.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 22px 20px;
                  background-color: #fafafa;
                  border-top: 1px solid #f1f5f9;
                "
              >
                <p
                  style="
                    margin: 0;
                    padding: 0;
                    color: #9ca3af;
                    font-size: 12px;
                    line-height: 1.5;
                  "
                >
                  © 2026 Time Table. All rights reserved.
                </p>
              </td>
            </tr>
          </table>

          <!-- Bottom Text -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
            style="width: 100%; max-width: 560px"
          >
            <tr>
              <td align="center" style="padding: 18px 20px 0">
                <p
                  style="
                    margin: 0;
                    padding: 0;
                    color: #a1a1aa;
                    font-size: 11px;
                    line-height: 1.6;
                  "
                >
                  This is an automated message. Please do not reply to this
                  email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
