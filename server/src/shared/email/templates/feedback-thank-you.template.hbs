<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='x-apple-disable-message-reformatting' />
    <title>Thank You for Your Feedback - Time Table</title>
  </head>

  <body
    style='margin:0;padding:0;background-color:#f5f5f5;font-family:Arial,Helvetica,sans-serif;color:#171717;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color:#f5f5f5;'
    >
      <tr>
        <td align='center' style='padding:40px 16px;'>

          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='max-width:580px;background-color:#ffffff;border:1px solid #e5e5e5;border-radius:14px;overflow:hidden;'
          >

            <!-- Brand header -->
            <tr>
              <td style='padding:26px 32px;border-bottom:1px solid #eeeeee;'>
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                >
                  <tr>
                    <td valign='middle'>
                      <table
                        role='presentation'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                      >
                        <tr>
                          <td
                            width='38'
                            height='38'
                            align='center'
                            valign='middle'
                            style='width:38px;height:38px;background-color:#171717;border-radius:10px;color:#ffffff;font-size:19px;font-weight:700;'
                          >
                            T
                          </td>
                          <td valign='middle' style='padding-left:11px;'>
                            <p
                              style='margin:0;color:#171717;font-size:18px;font-weight:700;letter-spacing:-0.5px;'
                            >
                              Time Table
                            </p>
                            <p
                              style='margin:3px 0 0;color:#737373;font-size:11px;'
                            >
                              YOUR VOICE MATTERS
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                    <td align='right' valign='middle'>
                      <span
                        style='display:inline-block;padding:7px 10px;background-color:#fafafa;border:1px solid #e5e5e5;border-radius:20px;color:#525252;font-size:11px;font-weight:700;'
                      >
                        FEEDBACK RECEIVED
                      </span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main content -->
            <tr>
              <td style='padding:40px 32px 36px;'>

                <!-- Confirmation icon -->
                <table
                  role='presentation'
                  align='center'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                >
                  <tr>
                    <td
                      width='62'
                      height='62'
                      align='center'
                      valign='middle'
                      style='width:62px;height:62px;background-color:#f5f5f5;border:1px solid #e5e5e5;border-radius:16px;color:#171717;font-size:28px;line-height:62px;'
                    >
                      &#10003;
                    </td>
                  </tr>
                </table>

                <p
                  style='margin:28px 0 12px;color:#737373;font-size:11px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;text-align:center;'
                >
                  Submission confirmed
                </p>

                <h1
                  style='margin:0;color:#171717;font-size:32px;line-height:1.25;font-weight:700;letter-spacing:-1px;text-align:center;'
                >
                  Thank you,
                  {{userName}}.
                </h1>

                <p
                  style='margin:18px 0 0;color:#525252;font-size:15px;line-height:1.9;text-align:center;'
                >
                  We appreciate you taking the time to share your thoughts. Your
                  feedback helps us make Time Table more useful, intuitive, and
                  better for everyone.
                </p>

                <!-- Feedback summary -->
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-top:32px;border:1px solid #e5e5e5;border-radius:10px;'
                >
                  <tr>
                    <td
                      colspan='2'
                      style='padding:19px 20px;background-color:#fafafa;border-bottom:1px solid #e5e5e5;border-radius:10px 10px 0 0;'
                    >
                      <p
                        style='margin:0;color:#171717;font-size:14px;font-weight:700;'
                      >
                        Your feedback summary
                      </p>
                      <p
                        style='margin:5px 0 0;color:#737373;font-size:12px;line-height:1.6;'
                      >
                        Here's a summary of your submission.
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td
                      valign='top'
                      style='padding:19px 20px;border-bottom:1px solid #eeeeee;'
                    >
                      <p style='margin:0 0 7px;color:#737373;font-size:12px;'>
                        Feedback category
                      </p>
                      <p
                        style='margin:0;color:#171717;font-size:14px;font-weight:700;line-height:1.7;word-break:break-word;'
                      >
                        {{category}}
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td style='padding:19px 20px;'>
                      <p style='margin:0 0 10px;color:#737373;font-size:12px;'>
                        Your rating
                      </p>
                      <p
                        style='margin:0;color:#171717;font-size:25px;line-height:1.4;font-weight:700;'
                      >
                        {{rating}}
                        <span
                          style='color:#737373;font-size:15px;font-weight:400;'
                        >/ 5</span>
                      </p>
                      <p
                        style='margin:5px 0 0;color:#737373;font-size:12px;line-height:1.7;'
                      >
                        Thank you for sharing your experience.
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Next steps -->
                <h2
                  style='margin:34px 0 10px;color:#171717;font-size:20px;line-height:1.4;font-weight:700;letter-spacing:-0.3px;text-align:center;'
                >
                  We're listening.
                </h2>

                <p
                  style='margin:0;color:#525252;font-size:14px;line-height:1.9;text-align:center;'
                >
                  Every suggestion and idea gives us an opportunity to improve.
                  Our team can use your feedback to help prioritize future
                  enhancements.
                </p>

                <!-- Closing message -->
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin-top:28px;background-color:#fafafa;border:1px solid #eeeeee;border-radius:10px;'
                >
                  <tr>
                    <td align='center' style='padding:20px 22px;'>
                      <p
                        style='margin:0;color:#171717;font-size:14px;font-weight:700;line-height:1.7;'
                      >
                        Thank you for being part of our community.
                      </p>
                      <p
                        style='margin:7px 0 0;color:#737373;font-size:12px;line-height:1.8;'
                      >
                        Together, we're making every day easier to organize.
                      </p>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='padding:24px 32px;background-color:#fafafa;border-top:1px solid #eeeeee;'
              >
                <p
                  style='margin:0;color:#171717;font-size:13px;font-weight:700;'
                >
                  Time Table
                </p>

                <p
                  style='margin:8px 0 0;color:#737373;font-size:11px;line-height:1.8;'
                >
                  Plan smarter. Achieve more.
                </p>

                <p
                  style='margin:18px 0 0;color:#a3a3a3;font-size:11px;line-height:1.8;'
                >
                  &copy; 2026 Time Table. All rights reserved.<br />
                  This is an automated email. Please do not reply.
                </p>
              </td>
            </tr>

          </table>

          <p
            style='max-width:400px;margin:20px auto 0;color:#a3a3a3;font-size:11px;line-height:1.7;text-align:center;'
          >
            You received this email because feedback was submitted through Time
            Table.
          </p>

        </td>
      </tr>
    </table>
  </body>
</html>