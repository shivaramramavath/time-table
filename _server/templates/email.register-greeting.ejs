<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="x-apple-disable-message-reformatting" />

    <title>Welcome to Time Table</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f4f5;
      font-family: Arial, Helvetica, sans-serif;
      color: #111827;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      role="presentation"
      style="width: 100%; margin: 0; padding: 0; background-color: #f4f4f5"
    >
      <tr>
        <td align="center" style="padding: 40px 16px">
          <!-- Main Container -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
            style="
              width: 100%;
              max-width: 560px;
              background-color: #ffffff;
              border: 1px solid #e5e7eb;
              border-radius: 20px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 34px 24px; background-color: #111111"
              >
                <h1
                  style="
                    margin: 0;
                    padding: 0;
                    color: #ffffff;
                    font-size: 28px;
                    line-height: 1.2;
                    font-weight: 700;
                  "
                >
                  Time Table
                </h1>

                <p
                  style="
                    margin: 10px 0 0;
                    padding: 0;
                    color: #a1a1aa;
                    font-size: 14px;
                    line-height: 1.5;
                  "
                >
                  Account registration successful
                </p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 42px 32px">
                <!-- Welcome -->
                <h2
                  style="
                    margin: 0;
                    padding: 0;
                    color: #111827;
                    font-size: 26px;
                    line-height: 1.3;
                    font-weight: 700;
                    text-align: center;
                  "
                >
                  Welcome, <%= userName %> 🎉
                </h2>

                <p
                  style="
                    margin: 16px 0 0;
                    padding: 0;
                    color: #6b7280;
                    font-size: 15px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  Thank you for joining Time Table. Your account has been
                  created successfully and is ready to use.
                </p>

                <!-- User Details -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                  style="margin: 34px 0"
                >
                  <tr>
                    <td>
                      <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        role="presentation"
                        style="
                          background-color: #fafafa;
                          border: 1px solid #e5e7eb;
                          border-radius: 16px;
                        "
                      >
                        <tr>
                          <td style="padding: 22px">
                            <p
                              style="
                                margin: 0 0 12px;
                                padding: 0;
                                color: #111827;
                                font-size: 15px;
                                line-height: 1.5;
                              "
                            >
                              <strong> Username: </strong>
                              <%= userName %>
                            </p>

                            <p
                              style="
                                margin: 0;
                                padding: 0;
                                color: #111827;
                                font-size: 15px;
                                line-height: 1.5;
                                word-break: break-word;
                              "
                            >
                              <strong> Email: </strong>
                              <%= email %>
                            </p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <!-- Welcome Message -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                  style="
                    background-color: #fafafa;
                    border: 1px solid #e5e7eb;
                    border-radius: 14px;
                  "
                >
                  <tr>
                    <td style="padding: 18px">
                      <p
                        style="
                          margin: 0;
                          padding: 0;
                          color: #52525b;
                          font-size: 14px;
                          line-height: 1.8;
                          text-align: center;
                        "
                      >
                        You can now sign in and start managing your schedules,
                        classes, and activities efficiently.
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Closing -->
                <p
                  style="
                    margin: 28px 0 0;
                    padding: 0;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  We're glad to have you with us. Enjoy using Time Table!
                </p>

                <!-- Security Notice -->
                <p
                  style="
                    margin: 24px 0 0;
                    padding: 0;
                    color: #9ca3af;
                    font-size: 12px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  If you did not create this account, please contact our support
                  team immediately.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 22px 20px;
                  background-color: #fafafa;
                  border-top: 1px solid #f1f5f9;
                "
              >
                <p
                  style="
                    margin: 0;
                    padding: 0;
                    color: #9ca3af;
                    font-size: 12px;
                    line-height: 1.5;
                  "
                >
                  © 2026 Time Table. All rights reserved.
                </p>
              </td>
            </tr>
          </table>

          <!-- Automated Message -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
            style="width: 100%; max-width: 560px"
          >
            <tr>
              <td align="center" style="padding: 18px 20px 0">
                <p
                  style="
                    margin: 0;
                    padding: 0;
                    color: #a1a1aa;
                    font-size: 11px;
                    line-height: 1.6;
                  "
                >
                  This is an automated message. Please do not reply to this
                  email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
