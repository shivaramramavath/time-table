
@baseUrl = http://localhost:8080/api
@email = ramavathshiva6300@gmail.com
@password = 12345678

### 1. Sign up
POST {{baseUrl}}/auth/signup
Content-Type: application/json
Accept: application/json

{
  "userName": "test-1",
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 2. Sign in
POST {{baseUrl}}/auth/signin
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### 3. Refresh access token
# Sends the refreshToken cookie received from sign-in.
POST {{baseUrl}}/auth/refresh
Accept: application/json

###

### 4. Sign out
# Requires a valid refreshToken cookie.
POST {{baseUrl}}/auth/signout
Accept: application/json

###

### 5. Forgot password
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}"
}

###

