<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>New Feedback Received</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f4f5;
      font-family: Arial, Helvetica, sans-serif;
      color: #111827;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      role="presentation"
      style="width: 100%; margin: 0; padding: 0; background-color: #f4f4f5"
    >
      <tr>
        <td align="center" style="padding: 40px 16px">
          <!-- Main Container -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
            style="
              width: 100%;
              max-width: 560px;
              background-color: #ffffff;
              border: 1px solid #e5e7eb;
              border-radius: 20px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 34px 24px; background-color: #111111"
              >
                <h1
                  style="
                    margin: 0;
                    padding: 0;
                    color: #ffffff;
                    font-size: 28px;
                    line-height: 1.2;
                    font-weight: 700;
                  "
                >
                  Time Table
                </h1>

                <p
                  style="
                    margin: 10px 0 0;
                    padding: 0;
                    color: #a1a1aa;
                    font-size: 14px;
                    line-height: 1.5;
                  "
                >
                  New feedback received
                </p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 42px 32px">
                <!-- Title -->
                <h2
                  style="
                    margin: 0;
                    padding: 0;
                    color: #111827;
                    font-size: 26px;
                    line-height: 1.3;
                    font-weight: 700;
                    text-align: center;
                  "
                >
                  New User Feedback
                </h2>

                <p
                  style="
                    margin: 16px 0 0;
                    padding: 0;
                    color: #6b7280;
                    font-size: 15px;
                    line-height: 1.7;
                    text-align: center;
                  "
                >
                  A user has submitted new feedback for Time Table.
                </p>

                <!-- Rating -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                  style="margin: 34px 0 20px"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        padding: 20px;
                        background-color: #fafafa;
                        border: 1px solid #e5e7eb;
                        border-radius: 16px;
                      "
                    >
                      <p
                        style="
                          margin: 0;
                          color: #6b7280;
                          font-size: 13px;
                          line-height: 1.5;
                        "
                      >
                        Rating
                      </p>

                      <p
                        style="
                          margin: 8px 0 0;
                          color: #111827;
                          font-size: 24px;
                          line-height: 1.4;
                          font-weight: 700;
                          letter-spacing: 2px;
                        "
                      >
                        <%= rating %> / 5
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Feedback Message -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                  style="
                    background-color: #fafafa;
                    border: 1px solid #e5e7eb;
                    border-radius: 16px;
                  "
                >
                  <tr>
                    <td style="padding: 22px">
                      <p
                        style="
                          margin: 0 0 10px;
                          padding: 0;
                          color: #111827;
                          font-size: 14px;
                          line-height: 1.5;
                          font-weight: 700;
                        "
                      >
                        Feedback
                      </p>

                      <p
                        style="
                          margin: 0;
                          padding: 0;
                          color: #52525b;
                          font-size: 14px;
                          line-height: 1.8;
                          word-break: break-word;
                        "
                      >
                        <%= message %>
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Admin Notice -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  role="presentation"
                  style="margin-top: 24px"
                >
                  <tr>
                    <td
                      style="
                        padding: 18px;
                        background-color: #fafafa;
                        border: 1px solid #e5e7eb;
                        border-radius: 14px;
                      "
                    >
                      <p
                        style="
                          margin: 0;
                          padding: 0;
                          color: #52525b;
                          font-size: 13px;
                          line-height: 1.7;
                          text-align: center;
                        "
                      >
                        This feedback has been submitted by a Time Table user
                        and is available for admin review.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 22px 20px;
                  background-color: #fafafa;
                  border-top: 1px solid #f1f5f9;
                "
              >
                <p
                  style="
                    margin: 0;
                    padding: 0;
                    color: #9ca3af;
                    font-size: 12px;
                    line-height: 1.5;
                  "
                >
                  © 2026 Time Table. All rights reserved.
                </p>
              </td>
            </tr>
          </table>

          <!-- Automated Message -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            role="presentation"
            style="width: 100%; max-width: 560px"
          >
            <tr>
              <td align="center" style="padding: 18px 20px 0">
                <p
                  style="
                    margin: 0;
                    padding: 0;
                    color: #a1a1aa;
                    font-size: 11px;
                    line-height: 1.6;
                  "
                >
                  This is an automated notification for administrators. Please
                  do not reply to this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
